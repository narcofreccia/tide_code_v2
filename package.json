{
  "name": "tide-code-v2",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @tide/server --filter @tide/web dev",
    "dev:server": "pnpm --filter @tide/server dev",
    "dev:web": "pnpm --filter @tide/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "desktop:dev": "pnpm --filter @tide/desktop tauri dev",
    "desktop:build": "pnpm --filter @tide/desktop tauri build",
    "desktop:sidecar": "./scripts/build-server-sidecar.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
