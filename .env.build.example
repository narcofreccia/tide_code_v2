# Tide v2 release-time secrets and config (copy to .env.build (gitignored) and fill in).
# Sourced by scripts/release/build_release.sh with `set -a`.

# --- Apple (macOS codesign + notarization) — same account as tide_code v1 ---
export APPLE_ID="your@email.com"
export APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"  # appleid.apple.com -> App-Specific Passwords
export APPLE_NOTARY_TEAM_ID="ABCDE12345"
export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (ABCDE12345)"

# --- Tauri updater signing (private key lives at ~/.tauri/tidecode2.key) ---
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD="tidecode2"   # password of ~/.tauri/tidecode2.key

# --- Cloudflare R2 release target (house `storage` bucket, `tidecode` prefix) ---
export R2_RELEASE_ENDPOINT_URL=https://d76960bd74940e6213de6aa16f3e04fd.r2.cloudflarestorage.com
export R2_RELEASE_BUCKET=s3://storage/tidecode
export R2_RELEASE_PUBLIC_URL=https://pub-7b3e5bbd605d43adbeb4601a962d84bd.r2.dev/tidecode
export R2_RELEASE_PROFILE=r2

# Aliases accepted as fallbacks (tide_reel/tide_share naming):
#   APPLE_PASSWORD  -> APPLE_APP_PASSWORD
#   APPLE_TEAM_ID   -> APPLE_NOTARY_TEAM_ID
# Optional override of the updater private key file (default ~/.tauri/tidecode2.key):
#   export TAURI_SIGNING_PRIVATE_KEY_FILE="$HOME/.tauri/tidecode2.key"
