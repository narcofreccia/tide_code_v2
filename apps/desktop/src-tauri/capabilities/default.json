{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tide desktop shell: open external links, remember window state, restart/exit.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-webview-close",
    "shell:allow-open",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
