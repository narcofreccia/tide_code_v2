{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Tide",
  "version": "../../../package.json",
  "identifier": "dev.tide.code",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @tide/web dev",
    "beforeBuildCommand": "pnpm --filter @tide/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tide",
        "url": "tide-shell://localhost/",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0e1013",
        "trafficLightPosition": {
          "x": 12,
          "y": 10
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/tide-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "entitlements": "../../../scripts/release/entitlements.plist",
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://pub-7b3e5bbd605d43adbeb4601a962d84bd.r2.dev/tidecode/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGODBGODU4M0E4QjYwQzMKUldURFlJczZXUGlBMzliOHV0ZkRMQ3A2SVhMdVV3ZEliVUQxbm82NmdFTDNILzZ0ZHl4RFVDaE4K"
    }
  }
}
