index 000000000000..ae81316580bb
--- /dev/null
+++ b/apps/web/src/components/chat/markdownStreamBlocks.test.tsx
@@ -0,0 +1,61 @@
+import {
+  CHAT_MARKDOWN_REHYPE_PLUGINS,
+  CHAT_MARKDOWN_REMARK_PLUGINS,
+} from "@t3tools/shared/markdownPipeline";
+import { renderToStaticMarkup } from "react-dom/server";
+import ReactMarkdown from "react-markdown";
+import { describe, expect, it } from "vite-plus/test";
+
+import { splitMarkdownBlocks } from "./markdownStreamBlocks";
+
+// Whitespace between top-level blocks collapses in the rendered message.
+const html = (source: string) =>
+  renderToStaticMarkup(
+    <ReactMarkdown
+      remarkPlugins={CHAT_MARKDOWN_REMARK_PLUGINS}
+      rehypePlugins={CHAT_MARKDOWN_REHYPE_PLUGINS}
+    >
+      {source}
+    </ReactMarkdown>,
+  )
+    .replace(/>\s+</g, "><")
+    .trim();
+
+describe("splitMarkdownBlocks", () => {
+  it.each([
+    "# Title\n\nFirst paragraph with `code` and **bold**.\n\nSecond [link](https://example.com).",
+    "- one\n- two\n\n- loose three\n\n  continued\n\nAfter the list.",
+    "1. first\n\n2. second\n\nText\n\n3) restarted",
+    "```ts\nconst a = 1;\n\n\nconst b = 2;\n```\n\nafter\n\n~~~\nx\n\n~~~~\n\ny\n~~~\n\nend",
+    "> quote\n\n> another quote\n\n> [!NOTE]\n> alert",
+    "| a | b |\n| - | - |\n| 1 | 2 |\n\nAfter the table.",
+    "para\n\n    indented code\n\nnext",
+    "Setext\n===\n\nnext\n---\n\n- [ ] task\n- [x] done",
+  ])("renders each block as the whole text renders it, at every streamed prefix: %j", (text) => {
+    for (let end = 0; end <= text.length; end++) {
+      const source = text.slice(0, end);
+      const blocks = splitMarkdownBlocks(source);
+      expect(blocks?.join("")).toBe(source);
+      expect(blocks!.map(html).join("")).toBe(html(source));
+    }
+  });
+
+  it("splits only between closed blocks", () => {
+    expect(splitMarkdownBlocks("a\n\n```\nb\n\nc\n```\n\n- d\n\n- e\n\nf")).toEqual([
+      "a\n\n",
+      "```\nb\n\nc\n```\n\n- d\n\n- e\n\n",
+      "f",
+    ]);
+  });
+
+  it.each([
+    "[ref]\n\n[ref]: /later",
+    "a[^x]\n\n[^x]: note",
+    "<details>\n\nbody\n\n</details>",
+    ":::note\n\ncontent\n\n:::",
+    "$$\na\n\nb\n$$",
+    "a\r\n\r\nb",
+  ])("keeps text with document-wide syntax whole: %j", (text) => {
+    expect(splitMarkdownBlocks(text)).toBeNull();
+  });
+});
diff --git a/apps/web/src/components/chat/markdownStreamBlocks.ts b/apps/web/src/components/chat/markdownStreamBlocks.ts
new file mode 100644
index 000000000000..52415ae71977
--- /dev/null
+++ b/apps/web/src/components/chat/markdownStreamBlocks.ts
@@ -0,0 +1,43 @@
+// Definitions, footnotes, raw HTML, container directives and display math can tie blocks together.
+const DOCUMENT_WIDE_SYNTAX = /^ {0,3}(?:\[[^\]\n]+\]:|<[A-Za-z!?/]|:::|\$\$)|\[\^/m;
+const FENCE_PATTERN = /^ {0,3}(`{3,}|~{3,})/;
+// After a blank line these still continue the previous block: a list item or indented content.
+const CONTINUATION_PATTERN = /^(?:[ \t]|(?:[-*+]|\d{1,9}[.)])(?:[ \t]|$))/;
+
+/**
+ * Cuts Markdown at blank lines that close every open block, so each piece renders exactly as it
+ * would inside the whole text. Returns null when the text uses syntax that spans blocks.
+ */
+export function splitMarkdownBlocks(text: string): string[] | null {
+  if (text.includes("\r") || DOCUMENT_WIDE_SYNTAX.test(text)) return null;
+  const blocks: string[] = [];
+  let blockStart = 0;
+  let lineStart = 0;
+  let fence: string | null = null;
+  let afterBlankLine = false;
+  for (const line of text.split("\n")) {
+    const opener = FENCE_PATTERN.exec(line)?.[1];
+    if (fence !== null) {
+      if (
+        opener &&
+        opener[0] === fence[0] &&
+        opener.length >= fence.length &&
+        line.trim() === opener
+      ) {
+        fence = null;
+      }
+    } else if (line.trim() === "") {
+      afterBlankLine = true;
+    } else {
+      if (afterBlankLine && lineStart > blockStart && !CONTINUATION_PATTERN.test(line)) {
+        blocks.push(text.slice(blockStart, lineStart));
+        blockStart = lineStart;
+      }
+      afterBlankLine = false;
+      fence = opener ?? null;
+    }
+    lineStart += line.length + 1;
+  }
+  blocks.push(text.slice(blockStart));
+  return blocks;
+}
